# Copy to .env. Local JWT keys below are the public Supabase CLI demo keys
# (same values `supabase status` prints). Replace them only if you rotate jwt_secret.
# From host browser / Next.js: use localhost.
# From Docker containers (api/web): use host.docker.internal to reach Supabase on the host.
#
# Local ports (see supabase/config.toml): API 55321 / DB 55322 / Studio 55323
# (avoids other Supabase projects and Windows reserved port ranges)

# --- Supabase (local) ---
SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# Postgres connection string from `supabase status`
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres

# --- Docker services: reach host Supabase ---
SUPABASE_URL_DOCKER=http://host.docker.internal:55321
DATABASE_URL_DOCKER=postgresql://postgres:postgres@host.docker.internal:55322/postgres

# --- FastAPI ---
API_CORS_ORIGINS=http://localhost:3000
API_PUBLIC_URL=http://localhost:8000

# --- Next.js (browser-facing; must be localhost, not host.docker.internal) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
