# Copy to .env and fill values from `supabase status` after `supabase start`.
# From host browser / Next.js: use localhost.
# From Docker containers (api/web): use host.docker.internal to reach Supabase on the host.

# --- Supabase (local defaults) ---
# Host-side URL (for documentation / local non-Docker runs)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Postgres connection string from `supabase status` (use Session mode / direct URL)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- Docker services: reach host Supabase ---
SUPABASE_URL_DOCKER=http://host.docker.internal:54321
DATABASE_URL_DOCKER=postgresql://postgres:postgres@host.docker.internal:54322/postgres

# --- FastAPI ---
API_CORS_ORIGINS=http://localhost:3000
API_PUBLIC_URL=http://localhost:8000

# --- Next.js (browser-facing; must be localhost, not host.docker.internal) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
