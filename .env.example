# Copy to .env and fill values from `supabase status` after `supabase start`.
# From host browser / Next.js: use localhost.
# From Docker containers (api/web): use host.docker.internal to reach Supabase on the host.
#
# Local ports (see supabase/config.toml): API 55321 / DB 55322 / Studio 55323
# (avoids other Supabase projects and Windows reserved port ranges)

# --- Supabase (local) ---
SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Postgres connection string from `supabase status`
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres

# --- Docker services: reach host Supabase ---
SUPABASE_URL_DOCKER=http://host.docker.internal:55321
DATABASE_URL_DOCKER=postgresql://postgres:postgres@host.docker.internal:55322/postgres

# --- FastAPI ---
API_CORS_ORIGINS=http://localhost:3000
API_PUBLIC_URL=http://localhost:8000

# --- Next.js (browser-facing; must be localhost, not host.docker.internal) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Qwen / vLLM (FastAPI container -> host) ---
AI_BASE_URL=http://host.docker.internal:8080/v1
AI_API_KEY=local
AI_MODEL=Qwen3.8-27B-NVFP4


# --- Address geocoding fallback (server-side only) ---
# Optional: GSI is tried first; ORS is only used when GSI cannot resolve an address.
ORS_API_KEY=
ORS_GEOCODING_API_URL=https://api.openrouteservice.org/geocode/search
ORS_GEOCODING_MIN_CONFIDENCE=0.8

# 車・徒歩・自転車で使用（Google Routes API）
GOOGLE_MAPS_API_KEY=
GOOGLE_ROUTES_MATRIX_API_URL=https://routes.googleapis.com/distanceMatrix/v2:computeRouteMatrix

# 公共交通（徒歩＋電車・地下鉄・バス）: ODPT + OpenTripPlanner
OTP_API_URL=http://otp:8080/otp/gtfs/v1
# 東京メトロ追加用（公共交通オープンデータセンターの無料開発者トークン）
ODPT_ACCESS_TOKEN=
# JR東日本追加用（公共交通オープンデータチャレンジ2026トークン）
ODPT_CHALLENGE_ACCESS_TOKEN=
ROUTE_TRANSIT_CANDIDATE_LIMIT=8

# --- Sales route planner tuning ---
ROUTE_CANDIDATE_LIMIT=20
ROUTE_PORTFOLIO_LIMIT=10
ROUTE_SEARCH_RADIUS_KM=30
ROUTE_MAX_SEARCH_RADIUS_KM=200
ROUTE_SOLVER_TIME_LIMIT_SEC=5
ROUTE_SALES_WEIGHT=25
ROUTE_GROSS_PROFIT_WEIGHT=35
ROUTE_URGENCY_WEIGHT=20
ROUTE_PHASE_WEIGHT=10
ROUTE_TARGET_GAP_WEIGHT=10
